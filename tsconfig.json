{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "types": [
            "webpack",
            "vue",
            "node"
        ],
        "baseUrl": "."
    },
    "include": [
        "./src/**/*.ts",
        "./config/**/*.ts",
        "./src/**/*.vue"
    ]
}