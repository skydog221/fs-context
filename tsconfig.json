{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": [
            "webpack-env",
            "node"
        ],
        "baseUrl": ".",
        "outDir": "dist/native",
        "paths": {
            "fs-context": [
                "src/fs-context/index"
            ],
            "fs-context/native-plugin": [
                "src/native/structs/plugin"
            ],
            "package.json": [
                "package.json"
            ],
            "fs-context/*": [
                "src/fs-context/*"
            ],
            "@/*": [
                "src/extension/*"
            ],
            "@sample/*": [
                "src/fs-context/samples/*"
            ],
            "@plugin/*": [
                "plugins/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "plugins/**/*.ts"
    ]
}