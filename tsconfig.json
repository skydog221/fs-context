{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "types": [
            "webpack-env",
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "framework/*": [
                "framework/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ]
}